#dialog {
    padding: 1 2;
    margin: 1 2;
    width: 72;
    height: auto;
    max-height: 80%;
    border: thick $accent;
    background: $surface;
}

TabbedContent {
    height: 1fr;
}

TabPane {
    height: 1fr;
}

#dialog-title {
    text-align: center;
    text-style: bold;
    width: 100%;
    margin-bottom: 1;
}

#dialog-body {
    width: 100%;
    height: 1fr;
}

FormField {
    margin-bottom: 1;
}

FormField Label {
    text-style: bold;
}

#dialog-buttons {
    dock: bottom;
    width: 100%;
    height: auto;
    margin-top: 1;
    align: center middle;
}

#dialog-buttons Button {
    margin: 0 1;
}

DataTable {
    width: 100%;
    height: 1fr;
}

.status-bar {
    height: 1;
    width: 100%;
    background: $accent;
    color: $text;
    padding: 0 1;
}

.action-bar {
    dock: bottom;
    height: 3;
    width: 100%;
    padding: 0 1;
    align: center middle;
}

.action-bar Button {
    margin: 0 1;
}

.error-toast {
    padding: 1 2;
    background: $error;
    color: $text;
    border: thick $error;
}

.success-toast {
    padding: 1 2;
    background: $success;
    color: $text;
    border: thick $success;
}

#detail-view {
    width: 100%;
    height: auto;
    padding: 1 2;
}

.detail-field {
    margin-bottom: 1;
}

.detail-label {
    text-style: bold;
    color: $accent;
}

.detail-value {
    margin-left: 2;
}

.resolve-result {
    padding: 1 2;
    width: 100%;
    height: auto;
}

.resolve-section-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}
